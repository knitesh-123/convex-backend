# Convex ports exposed on the backend droplet.
PORT=3210
SITE_PROXY_PORT=3211
DASHBOARD_PORT=6791

# Public URLs. Use your real HTTPS URLs if you have a reverse proxy.
CONVEX_CLOUD_ORIGIN=http://your-backend-public-host:3210
CONVEX_SITE_ORIGIN=http://your-backend-public-host:3211
NEXT_PUBLIC_DEPLOYMENT_URL=http://your-backend-public-host:3210

# Convex deployment identity. Reuse the same values anywhere you run this
# deployment (Railway, DigitalOcean, local Docker, etc.).
INSTANCE_NAME=my-app-prod
INSTANCE_SECRET=replace-with-a-generated-instance-secret

# Choose exactly one database connection.
# For PlanetScale / Vitess, create a database whose name matches INSTANCE_NAME
# with '-' replaced by '_', and do not include the database name here.
MYSQL_URL=mysql://username:password@aws.connect.psdb.cloud
# POSTGRES_URL=postgresql://username:password@db.example.com

# Cloudflare R2 / S3-compatible storage.
AWS_REGION=auto
AWS_ACCESS_KEY_ID=replace-with-r2-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
S3_STORAGE_EXPORTS_BUCKET=convex-snapshot-exports
S3_STORAGE_SNAPSHOT_IMPORTS_BUCKET=convex-snapshot-imports
S3_STORAGE_MODULES_BUCKET=convex-modules
S3_STORAGE_FILES_BUCKET=convex-user-files
S3_STORAGE_SEARCH_BUCKET=convex-search-indexes

# Uncomment only if your S3-compatible provider requires them.
# AWS_S3_FORCE_PATH_STYLE=false
# AWS_S3_DISABLE_SSE=true
# AWS_S3_DISABLE_CHECKSUMS=true

# Backend logging / metrics.
DISABLE_METRICS_ENDPOINT=false
LOG_FORMAT=json
RUST_LOG=info
REDACT_LOGS_TO_CLIENT=true

# Metrics adapter port exposed to the observability droplet.
METRICS_ADAPTER_BIND_IP=0.0.0.0
METRICS_ADAPTER_PORT=9464
